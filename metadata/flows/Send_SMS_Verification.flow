    <decisions>
        <name>Check_if_messaging_user_found</name>
        <label>Check if messaging user found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Messaging_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Messaging_user_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Messaging_user.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Messaging_User</targetReference>
            </connector>
            <label>Messaging user found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_VC_or_Messaging</name>
        <label>Check if VC or Messaging</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Messaging_Session</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is Messaging</defaultConnectorLabel>
        <rules>
            <name>Is_VoiceCall</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_VoiceCall.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Messaging_user</targetReference>
            </connector>
            <label>Is VoiceCall</label>
        </rules>
    </decisions>
    <environments>Default</environments>
