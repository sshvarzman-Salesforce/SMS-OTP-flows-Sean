        <fullName>ServiceCustomerVerification_16jHn00000005qM</fullName>
        <canEscalate>false</canEscalate>
        <description>Use this topic immediately at the start of every new conversation before any other topic is used, regardless of what the customer says.</description>
        <developerName>ServiceCustomerVerification_16jHn00000005qM</developerName>
        <genAiPluginInstructions>
            <description>Always run this topic first at the start of every conversation before any other topic is accessed.</description>
            <developerName>authentication_only</developerName>
            <language xsi:nil="true"/>
            <masterLabel>authentication_only</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Immediately invoke and execute the Send SMS Verification action. Do not skip this action, do not simulate it, and do not tell the customer a code was sent without first successfully executing this action. Only after the action has run, inform the customer: &quot;I&apos;ve sent a verification code to your phone number on file. Please share the code with me when you have it.</description>
            <developerName>prevent_user_switching_after_verification</developerName>
            <language xsi:nil="true"/>
            <masterLabel>prevent_user_switching_after_verification</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Once the customer provides the code, run the Verify SMS Code MFA action to validate the code they submitted.</description>
            <developerName>proceed_after_verification_success</developerName>
            <language xsi:nil="true"/>
            <masterLabel>proceed_after_verification_success</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the code is verified successfully, confirm to the customer that their identity has been verified and ask how you can assist them. Say: &quot;You&apos;re all set! How can I help you today?&quot;</description>
            <developerName>reenter_username_or_email_address</developerName>
            <language xsi:nil="true"/>
            <masterLabel>reenter_username_or_email_address</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the code is incorrect on the first attempt, let the customer know and give them one more chance. Run Send SMS Verification again to issue a new code, then run Verify SMS Code MFA a second time.</description>
            <developerName>security_prompt</developerName>
            <language xsi:nil="true"/>
            <masterLabel>security_prompt</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the customer fails verification a second time, inform them that their identity could not be verified and escalate the conversation immediately to a live agent. Do not provide access to any other topics or account information.</description>
            <developerName>send_verification_code</developerName>
            <language xsi:nil="true"/>
            <masterLabel>send_verification_code</masterLabel>
            <sortOrder>5</sortOrder>
        </genAiPluginInstructions>
